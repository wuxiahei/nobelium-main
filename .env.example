# Notion Integration Token (create at https://www.notion.so/my-integrations)
# Required for official API access (recommended)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID (from your database URL)
# Required when using NOTION_API_KEY
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: select the blog data source if the database contains multiple sources
NOTION_DATA_SOURCE_ID=
# Admin editing requires Read content + Update content and a database connection

# Notion Page ID (for unofficial API access, legacy)
# Only needed if NOTION_API_KEY is not configured
NOTION_PAGE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Notion Access Token (for unofficial API access, legacy)
# Only needed if NOTION_API_KEY is not configured
NOTION_ACCESS_TOKEN=

# Optional official Notion API throttling/retry tuning
NOTION_REQUEST_INTERVAL_MS=340
NOTION_MAX_RETRIES=6
NOTION_RETRY_BASE_MS=1000

# AI workspace (OpenAI-compatible provider; server-side only)
# The browser never receives AI_API_KEY and conversations are not persisted by the API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_DISPLAY_NAME=AI 助手
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048

# Secret used by POST /api/revalidate
# Generate a long random value, for example: openssl rand -hex 32
REVALIDATE_SECRET=

# Guest comments backed by GitHub Issues (no database required)
# You can reuse the site repository, for example: wuxiahei/nobelium-main.
# Comment issues do not have CONTENT_GITHUB_LABEL, so they are not treated as articles.
COMMENTS_GITHUB_REPO=
# Fine-grained token with Issues: Read and write, Metadata: Read-only.
# You may reuse CONTENT_GITHUB_TOKEN when both features use the same repository.
# Server-side only. Never expose this value to the browser.
COMMENTS_GITHUB_TOKEN=

# GitHub Issues as an optional article source (kept alongside Notion)
# No second repository is required. This may be the same repository as comments,
# for example: wuxiahei/nobelium-main. Article issues are identified by the label below.
CONTENT_GITHUB_REPO=
# Fine-grained token with Issues: Read and write and Metadata: Read-only.
# This is only needed for the /admin editor. Public article reads can be anonymous.
# When both features use the same repository, this can be the same token as COMMENTS_GITHUB_TOKEN.
CONTENT_GITHUB_TOKEN=
CONTENT_GITHUB_LABEL=nobelium-post
CONTENT_GITHUB_DRAFT_LABEL=nobelium-draft
CONTENT_GITHUB_TAG_PREFIX=tag:

# Admin-only writing at /admin (no public registration)
ADMIN_USERNAME=
# Recommended: set only ADMIN_PASSWORD_HASH.
# You still type your normal password on /admin. Vercel verifies it server-side against
# this one-way scrypt hash, so the original password cannot be recovered from the hash.
# Generate with: pnpm run admin:hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Legacy plaintext fallback; leave empty when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Defaults to 43200 seconds (12 hours); values above 7 days are capped.
ADMIN_SESSION_TTL_SECONDS=43200

# Vercel Blob storage for local image uploads in /admin
# Create a Blob store in Vercel and connect it to this project.
BLOB_READ_WRITE_TOKEN=
