# Notion Integration Token (create at https://www.notion.so/my-integrations)
# Required for official API access (recommended)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID (from your database URL)
# Required when using NOTION_API_KEY
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Page ID (for unofficial API access, legacy)
# Only needed if NOTION_API_KEY is not configured
NOTION_PAGE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Notion Access Token (for unofficial API access, legacy)
# Only needed if NOTION_API_KEY is not configured
NOTION_ACCESS_TOKEN=

# AI workspace (OpenAI-compatible provider; server-side only)
# The browser never receives AI_API_KEY and conversations are not persisted by the API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_DISPLAY_NAME=AI 助手
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048
